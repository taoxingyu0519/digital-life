{
  "name": "@proj-airi/realtime-voice",
  "type": "module",
  "private": true,
  "description": "Local Doubao full duplex voice gateway and browser audio",
  "exports": {
    "./brain": "./src/brain.ts",
    "./prompts": "./src/prompts.ts",
    "./conversation": "./src/conversation.ts",
    "./conversation-contract": "./src/conversation-contract.ts",
    "./contracts": "./src/contracts.ts",
    "./client": "./src/client.ts",
    "./audio": "./src/audio.ts",
